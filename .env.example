# Local config for the daily ingest. Copy to `.env` and edit.
# Sourced by run_daily_ingest.sh (set -a). `.env` is gitignored — never commit it.
# Keep KEY=VALUE, no spaces around '='.

# Contact email baked into the arXiv API User-Agent (arXiv etiquette; helps
# avoid 429 and lets arXiv reach you about heavy usage).
ARXIV_CONTACT_EMAIL=you@example.com

# Research-direction slug the daily cron updates (must already be registered via
# the skill's `new` + `init` flow). Default if unset: agent-harness.
DIRECTION=agent-harness

# Model id for the headless run. Use claude-sonnet-4-6 to cut cost.
MODEL=claude-opus-4-8

# Optional outbound proxy for the Anthropic API leg (only if direct egress is
# blocked on your host). arXiv always goes direct. Leave unset for a plain setup.
# PROXY=http://127.0.0.1:7897
