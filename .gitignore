# Local, stateful vault — synced manually, never committed (per user choice)
data/

# Python virtualenvs / caches
**/.venv/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Per-run ingest logs
logs/

# Local planning notes (not needed by the remote agent)
PLAN.md

# Local config (contact email, etc.) — not committed
.env

# OS cruft
.DS_Store
Thumbs.db
